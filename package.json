{
  "name": "ai-learning-platform-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:refresh": "bash scripts/dev-server-refresh.sh",
    "dev:refresh:quick": "pkill -f 'next dev' 2>/dev/null; rm -rf .next; npm run dev",
    "dev:refresh:check": "DEV_REFRESH_CHECK_CODE=true bash scripts/dev-server-refresh.sh",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "_comment": "注意: 通常は:strictコマンドは使用しない。標準のtypecheck/lint/buildを使用すること",
    "_typecheck:strict": "bash scripts/typecheck-strict.sh",
    "typecheck:project": "bash scripts/typecheck-project-only.sh",
    "_lint:strict": "bash scripts/lint-strict.sh",
    "_build:strict": "bash scripts/build-strict.sh",
    "quality:full-check": "bash scripts/quality-full-check.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest tests/api",
    "test:integration": "jest tests/integration",
    "test:schema": "jest tests/integration/schema-regression.test.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:env:production": "tsx scripts/validate-env.ts production",
    "migrate:questions": "tsx scripts/migrate-questions-to-db.ts",
    "check:course-consistency": "tsx scripts/check-course-master-consistency.ts",
    "check:course-consistency-static": "tsx scripts/check-course-master-consistency-static.ts",
    "check:db-consistency": "tsx scripts/check-database-consistency.ts",
    "sync:quiz-json": "tsx scripts/sync-quiz-data-to-json.ts",
    "analyze:data-reflection": "tsx scripts/analyze-data-reflection-status.ts",
    "analyze:learning-consistency": "NODE_ENV=development tsx --env-file=.env.local scripts/analyze-learning-data-consistency.ts",
    "analyze:quiz-answers": "NODE_ENV=development tsx --env-file=.env.local scripts/analyze-quiz-answers-detail.ts",
    "fix:learning-data": "NODE_ENV=development tsx --env-file=.env.local scripts/fix-learning-data-issues.ts",
    "fix:question-id-refs": "NODE_ENV=development tsx --env-file=.env.local scripts/fix-question-id-references.ts",
    "recalc:stats": "NODE_ENV=development tsx --env-file=.env.local scripts/recalculate-stats-from-answers.ts",
    "backup:all-user-data": "NODE_ENV=development tsx --env-file=.env.local scripts/backup-all-user-data.ts",
    "backup:verify": "NODE_ENV=development tsx --env-file=.env.local scripts/verify-backup-integrity.ts",
    "deploy:check-env": "npm run validate:env",
    "deploy:validate": "npm run validate:env && npm run typecheck && npm run build && npm run lint",
    "deploy:validate-skip-ts": "npm run validate:env && npm run build && npm run lint",
    "test:regression": "npm run typecheck && npm run lint && npm test -- tests/database/schema-regression.test.ts tests/api/course-completion.test.ts",
    "validate:pre-commit": "bash scripts/pre-commit-validation.sh",
    "monitor:data-health": "NODE_ENV=development tsx --env-file=.env.local scripts/monitor-critical-data.ts",
    "deploy:sync": "tsx scripts/deploy-sync-fallback-data.ts",
    "deploy:check": "npm run deploy:sync && npm run build && npm run lint",
    "deploy:pre": "npm run deploy:validate && echo 'デプロイ前完全検証完了 - git commit/push可能です'",
    "deploy:complete": "tsx scripts/deploy-complete.ts",
    "deploy:full": "npm run deploy:complete",
    "deploy:safe": "tsx scripts/ensure-static-data.ts && tsx scripts/deploy-safe-mode.ts",
    "deploy:safe-build": "npm run deploy:safe && npm run build",
    "ensure:static-data": "tsx scripts/ensure-static-data.ts",
    "generate:category-mapping": "npx tsx scripts/generate-category-mapping.ts",
    "test:category-cache": "npx tsx scripts/test-simple-cache.ts",
    "sync:all-fallback": "NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY npx tsx scripts/sync-all-fallback-data.ts",
    "sync:xp-fallback": "NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY npx tsx scripts/generate-xp-fallback.ts",
    "pre-deploy:check": "npm run generate:category-mapping && npx tsc --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@napi-rs/canvas": "^0.1.84",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-visually-hidden": "^1.2.3",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.75.0",
    "@tanstack/react-query": "^5.90.2",
    "@types/uuid": "^10.0.0",
    "@vercel/blob": "^2.0.0",
    "chart.js": "^4.5.0",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jstat": "^1.9.6",
    "lucide-react": "^0.542.0",
    "ml-matrix": "^6.12.1",
    "next": "^16.0.10",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.530",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^14.3.8",
    "simple-statistics": "^7.8.8",
    "swr": "^2.3.6",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^30.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "jest": "^30.2.0",
    "node-mocks-http": "^1.17.2",
    "supabase": "^2.47.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "^5",
    "zod": "^4.1.12"
  }
}
